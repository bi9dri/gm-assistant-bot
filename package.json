{
  "name": "gm-assistant-bot",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "lint": "vp lint",
    "fmt:check": "vp fmt --check backend/src frontend/src frontend/test",
    "format": "vp fmt backend/src frontend/src frontend/test",
    "check": "vp check",
    "typecheck": "vp -C frontend run typecheck && vp -C backend run typecheck",
    "dev": "vp -C frontend dev",
    "build": "vp -C frontend build",
    "deploy": "pnpm --filter gm-assistant-bot-backend deploy",
    "test": "vp -C frontend test && vp -C backend test",
    "knip": "knip",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "knip": "6.38.0",
    "typescript": "7.0.2",
    "vite-plus": "catalog:",
    "wrangler": "4.138.0"
  },
  "packageManager": "pnpm@12.6.0"
}
