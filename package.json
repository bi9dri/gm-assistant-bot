{
  "name": "gm-assistant-bot",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "lint": "bun --filter '*' lint",
    "format": "bun --filter '*' format",
    "typecheck": "bun --filter '*' typecheck",
    "dev": "bun --filter '*' dev",
    "build": "bun --filter '*' build",
    "deploy": "bun --filter gm-assistant-bot-backend deploy",
    "test": "bun --filter '*' test",
    "ncu": "ncu --packageManager bun --workspaces --cooldown 7",
    "knip": "knip"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "knip": "6.27.0",
    "npm-check-updates": "22.2.9",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "oxlint-tsgolint": "0.25.0",
    "typescript": "6.0.3",
    "wrangler": "4.114.0"
  }
}