{
  "name": "gm-assistant-bot",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "packageManager": "bun@1.3.13",
  "scripts": {
    "lint": "bun --filter '*' lint",
    "format": "bun --filter '*' format",
    "typecheck": "bun --filter '*' typecheck",
    "dev": "bun --filter '*' dev",
    "build": "bun --filter '*' build",
    "deploy": "bun --filter gm-assistant-bot-backend deploy",
    "test": "bun --filter '*' test",
    "knip": "knip",
    "check:bun-version": "bash scripts/check-bun-version.sh"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "knip": "6.32.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "wrangler": "4.123.0"
  },
  "overrides": {
    "shell-quote": "1.10.0"
  }
}
