{
  "name": "gm-assistant-bot",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "packageManager": "bun@1.3.13",
  "scripts": {
    "lint": "bun --filter '*' lint",
    "format": "bun --filter '*' format",
    "typecheck": "bun --filter '*' typecheck",
    "dev": "bun --filter '*' dev",
    "build": "bun --filter '*' build",
    "deploy": "bun --filter gm-assistant-bot-backend deploy",
    "test": "bun --filter '*' test",
    "ncu": "ncu --packageManager bun --workspaces --cooldown 7",
    "knip": "knip"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "knip": "6.32.2",
    "npm-check-updates": "23.0.2",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "0.23.0",
    "typescript": "7.0.2",
    "wrangler": "4.120.0"
  },
  "overrides": {
    "shell-quote": "1.10.0"
  }
}