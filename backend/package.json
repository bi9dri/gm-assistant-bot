{
  "name": "gm-assistant-bot-backend",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "test": "bun test",
    "lint": "oxlint && oxfmt --check ./src",
    "format": "oxlint --fix && oxfmt --write ./src",
    "typecheck": "oxlint --type-aware --type-check",
    "dev": "bun --hot --port 8787 ./src/index.ts",
    "preview": "wrangler dev --port 8787",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@discordjs/rest": "2.6.3",
    "@hono/zod-validator": "0.9.0",
    "discord-api-types": "0.38.53",
    "hono": "4.13.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260817.1",
    "@types/bun": "1.3.13",
    "typescript": "7.0.2"
  }
}