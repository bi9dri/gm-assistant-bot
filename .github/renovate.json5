{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  automerge: true,
  automergeType: 'pr',
  timezone: 'Asia/Tokyo',
  schedule: [
    'before 6am on monday',
  ],
  rebaseWhen: 'conflicted',
  rangeStrategy: 'pin',
  minimumReleaseAge: '7 days',
  internalChecksFilter: 'strict',
  dependencyDashboard: {
    enabled: true,
    osvVulnerabilitySummary: 'unresolved',
  },
  osvVulnerabilityAlerts: true,
  semanticCommits: 'enabled',
  commitMessageAction: '更新',
  commitMessageExtra: '({{currentVersion}} → {{newVersion}})',
  prConcurrentLimit: 5,
  vulnerabilityAlerts: {
    minimumReleaseAge: null,
    schedule: [
      'at any time',
    ],
  },
  packageRules: [
    {
      groupName: 'tiptap',
      matchPackageNames: [
        '@tiptap/**',
      ],
    },
    {
      groupName: 'non-major dependencies',
      matchManagers: [
        'npm',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
    },
    {
      groupName: 'tanstack-devtools',
      matchPackageNames: [
        '@tanstack/react-devtools',
        '@tanstack/devtools-vite',
      ],
    },
    {
      groupName: 'vite+',
      matchPackageNames: [
        'vite-plus',
        '@voidzero-dev/vite-plus-core',
      ],
      separateMajorMinor: false,
    },
    {
      groupName: 'github-actions',
      matchManagers: [
        'github-actions',
      ],
    },
    {
      matchDepTypes: [
        'workflow',
      ],
      pinDigests: true,
    },
    {
      matchPackageNames: [
        '@vitest/coverage-v8',
      ],
      enabled: false,
    },
    {
      groupName: 'tanstack-react-start',
      matchPackageNames: [
        '@tanstack/react-start',
        '@tanstack/react-router',
      ],
    },
  ],
}
