{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    // 外部 action を SHA + バージョンコメントに固定する（pinact 相当）
    "helpers:pinGitHubActionDigests",
  ],

  // 固定バージョンのみ（^ / ~ を使わない）
  rangeStrategy: "pin",

  // 公開から 7 日未満のリリースは PR にしない（ncu --cooldown 7 / pinact -m 7 相当）。
  // internalChecksFilter: strict で「保留中の新バージョン」も無視する。
  minimumReleaseAge: "7 days",
  internalChecksFilter: "strict",

  // 更新候補の一覧 Issue。ncu の結果を Issue にまとめる自前処理の置き換え。
  dependencyDashboard: true,
  dependencyDashboardOSVVulnerabilitySummary: "unresolved",
  osvVulnerabilityAlerts: true,

  semanticCommits: "enabled",
  commitMessageAction: "更新",
  commitMessageExtra: "({{currentVersion}} → {{newVersion}})",
  prConcurrentLimit: 5,

  // セキュリティ更新は 7 日ルールを迂回する（prConcurrentLimit も Renovate 側で自動的に免除される）
  vulnerabilityAlerts: {
    minimumReleaseAge: null,
  },

  packageRules: [
    {
      // @tiptap/* は互いに peerDependencies でバージョンを固定し合う。
      // 別々の PR に分かれると nested な @tiptap/core が二重に入り、
      // 拡張が加える ChainedCommands の型拡張が効かず typecheck が落ちる。
      groupName: "tiptap",
      matchPackageNames: ["@tiptap/**"],
    },
    {
      // Batched 相当: 影響の小さい minor / patch は 1 PR に集約
      groupName: "non-major dependencies",
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor", "patch"],
    },
    {
      // vite-plus 本体と pnpm catalog の `vite` (alias) は同じリリースで揃える必要がある。
      // non-major の一括 PR に埋もれると同梱 vitest の確認を落とすため専用グループ化。
      //
      // security PR は vulnerabilityAlerts の force (groupName: null) でグループから外れ、
      // vite-plus だけが上がって alias が 1 つ前のバージョンに取り残される。どのブランチでも
      // alias を同じ newVersion に同期させるため bumpVersions を使う。
      groupName: "vite+",
      matchPackageNames: ["vite-plus", "@voidzero-dev/vite-plus-core"],
      bumpVersions: [
        {
          name: "vite+ core alias",
          filePatterns: ["pnpm-workspace.yaml"],
          matchStrings: ["vite: npm:@voidzero-dev/vite-plus-core@(?<version>[^\\s]+)"],
          bumpType: "sync",
        },
      ],
    },
    {
      groupName: "github-actions",
      matchManagers: ["github-actions"],
    },
    {
      // @vitest/coverage-v8 は vite-plus が同梱する vitest と同じバージョンでないと
      // vp test が coverage provider 不一致で起動に失敗する（vitest の peerDependencies が exact）。
      // 独立更新を止め、vite-plus 更新時に同梱 vitest を確認して手動で合わせる。
      matchPackageNames: ["@vitest/coverage-v8"],
      enabled: false,
    },
    {
      // @tanstack/react-start が同梱する react-start-client は @tanstack/react-router を
      // exact で pin する。react-router だけが先に上がると router-core が二重に入り、
      // FilebaseRouteOptionsInterface への module augmentation が別コピーに当たって
      // route の `server` ハンドラーが型から消える (typecheck が落ちる)。
      // 逆向き (react-start だけ上がる) も同じ理由で落ちるが、security 更新を止める
      // わけにはいかないので、react-start の更新ブランチでは router を手で追随させる。
      matchPackageNames: ["@tanstack/react-router"],
      enabled: false,
    },
    // major は既定どおりパッケージごとの個別 PR（Individual 相当）。
    // vite+ は同リリースで揃える必要があるため例外として上のグループに含める。
  ],
}
