{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],

  automerge: true,
  automergeType: "pr",

  // 固定バージョンのみ（^ / ~ を使わない）
  rangeStrategy: "pin",

  // 公開から 7 日未満のリリースは PR にしない（npm / GitHub Actions 共通）。
  // internalChecksFilter: strict で「保留中の新バージョン」も無視する。
  minimumReleaseAge: "7 days",
  internalChecksFilter: "strict",

  // 更新候補の一覧 Issue。ncu の結果を Issue にまとめる自前処理の置き換え。
  dependencyDashboard: true,
  dependencyDashboardOSVVulnerabilitySummary: "unresolved",
  osvVulnerabilityAlerts: true,

  semanticCommits: "enabled",
  commitMessageAction: "更新",
  commitMessageExtra: "({{currentVersion}} → {{newVersion}})",
  prConcurrentLimit: 5,

  // セキュリティ更新は 7 日ルールを迂回する（prConcurrentLimit も Renovate 側で自動的に免除される）
  vulnerabilityAlerts: {
    minimumReleaseAge: null,
  },

  packageRules: [
    {
      // @tiptap/* は互いに peerDependencies でバージョンを固定し合う。
      // 別々の PR に分かれると nested な @tiptap/core が二重に入り、
      // 拡張が加える ChainedCommands の型拡張が効かず typecheck が落ちる。
      groupName: "tiptap",
      matchPackageNames: ["@tiptap/**"],
    },
    {
      // Batched 相当: 影響の小さい minor / patch は 1 PR に集約
      groupName: "non-major dependencies",
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor", "patch"],
    },
    {
      // @tanstack/react-devtools と @tanstack/devtools-vite は同じ TanStack/devtools
      // リポジトリで、どちらも @tanstack/devtools-event-bus / devtools-client を
      // exact で pin する。片方だけ上がると event-bus が二重になり、Vite プラグインが
      // 注入した bus とブラウザ側パネルが繋がらなくなる (開発時のみ)。
      groupName: "tanstack-devtools",
      matchPackageNames: ["@tanstack/react-devtools", "@tanstack/devtools-vite"],
    },
    {
      groupName: "vite+",
      matchPackageNames: ["vite-plus", "@voidzero-dev/vite-plus-core"],
      separateMajorMinor: false,
    },
    {
      // step の uses: は actions.lock が commit を固定するので、ワークフロー側は
      // タグ参照のままでよい。Renovate は action を更新すると同時に actions.lock も
      // 再生成する (gh-actions-lock 連携, experimental)。
      groupName: "github-actions",
      matchManagers: ["github-actions"],
    },
    {
      // 再利用可能ワークフロー (jobs.<id>.uses) は actions.lock の対象外なので、
      // 従来どおり SHA + バージョンコメントで固定する。
      matchDepTypes: ["workflow"],
      pinDigests: true,
    },
    {
      // @vitest/coverage-v8 は vite-plus が同梱する vitest と同じバージョンでないと
      // vp test が coverage provider 不一致で起動に失敗する（vitest の peerDependencies が exact）。
      // 独立更新を止め、vite-plus 更新時に同梱 vitest を確認して手動で合わせる。
      matchPackageNames: ["@vitest/coverage-v8"],
      enabled: false,
    },
    {
      // @tanstack/react-start は react-start-client から @tanstack/react-router を
      // exact で pin する。react-router だけが先に上がると router-core が二重に入り、
      // FilebaseRouteOptionsInterface への module augmentation が別コピーに当たって
      // route の `server` ハンドラーが型から消える (typecheck が落ちる)。逆向き
      // (react-start だけ上がる) も同じ理由で落ちるので、必ず同じ PR で上げる。
      // TanStack は同一バッチで公開するため minimumReleaseAge もほぼ同時に通る。
      // router 単独の patch が出た場合は、react-start の pin が追随するまでこの PR が
      // 一時的に赤くなる (追随後は同じブランチに取り込まれて解消する)。
      groupName: "tanstack-react-start",
      matchPackageNames: ["@tanstack/react-start", "@tanstack/react-router"],
    },
    // major は既定どおりパッケージごとの個別 PR（Individual 相当）。
    // vite+ は同リリースで揃える必要があるため例外として上のグループに含める。
  ],
}
