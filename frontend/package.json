{
  "name": "gm-assistant-bot-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "vp lint && vp fmt --check ./src ./test",
    "format": "vp lint --fix && vp fmt --write ./src ./test",
    "typecheck": "vp lint --type-aware --type-check",
    "dev": "vp dev --port 3000",
    "build": "vp build && tsc",
    "preview": "vp preview",
    "test": "vp test",
    "test:vrt": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:serve-static": "node test/vrt/serve-storybook-static.ts"
