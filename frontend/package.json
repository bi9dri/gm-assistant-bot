{
  "name": "gm-assistant-bot-frontend",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "lint": "oxlint && oxfmt --check ./src ./test",
    "format": "oxlint --fix && oxfmt --write ./src ./test",
    "typecheck": "oxlint --type-aware --type-check",
    "dev": "vite --port 3000",
    "build": "vite build && tsc",
    "preview": "vite preview",
    "test": "bun test",
    "test:vrt": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:serve-static": "bun test/vrt/serve-storybook-static.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-devtools": "0.10.10",
    "@tanstack/react-router": "1.170.29",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/router-plugin": "1.168.32",
    "@xyflow/react": "12.11.3",
    "@zip.js/zip.js": "2.8.51",
    "clsx": "2.1.1",
    "daisyui": "5.7.17",
    "dexie": "4.4.5",
    "dexie-react-hooks": "4.4.0",
    "hono": "4.13.2",
    "immer": "11.1.16",
    "nanoid": "6.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@storybook/addon-docs": "10.5.8",
    "@storybook/addon-themes": "10.5.8",
    "@storybook/react-vite": "10.5.8",
    "@tanstack/devtools-vite": "0.8.3",
    "@types/bun": "1.3.13",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "fake-indexeddb": "6.2.5",
    "msw": "2.15.0",
    "storybook": "10.5.8",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  },
  "msw": {
    "workerDirectory": [
      "test/vrt/msw"
    ]
  }
}