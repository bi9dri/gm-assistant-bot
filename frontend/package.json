    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@xyflow/react": "12.12.0",
    "@zip.js/zip.js": "2.18.2",
    "clsx": "2.1.1",
    "daisyui": "5.7.47",
